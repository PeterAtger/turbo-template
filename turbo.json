{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DEVELOPMENT",
    "BASE_URL",
    "CRYPTO_SECRET_KEY",
    "CRYPTO_SECRET_IV",
    "CRYPTO_ECNRYPTION_METHOD",
    "CLERK_SECRET_KEY",
    "CRON_SECRET",
    "BUILD_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
